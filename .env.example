# Optional. Without this, live AQI falls back to WAQI's shared "demo" token,
# which is rate-limited and not reliable to demo live. Get a free instant
# token at https://aqicn.org/data-platform/token/ and set it here (and as a
# repo secret / build env var in CI) for a reliable live PM10 reading.
VITE_WAQI_TOKEN=

# Required for the live Triage Inbox backend (Supabase) and officer sign-in.
# Without these, the app falls back to seeded demo grievances and the
# citizen-intake form / triage actions are hidden. Get these from your
# Supabase project: Settings > API.
# Run supabase/schema.sql in the Supabase SQL Editor once to create the
# grievances table before setting these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
